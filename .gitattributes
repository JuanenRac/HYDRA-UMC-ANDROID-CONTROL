# Auto detect text files and perform LF normalization
* text=auto

# Explicit line endings for the scripts every platform's shell needs to run
# directly, independent of each cloning machine's own core.autocrlf setting
# (relying on that alone is what caused gradlew.bat/build-android.bat to be
# checked out with LF-only endings on Windows and fail with cryptic
# "'x' is not recognized as an internal or external command" errors - CRLF
# is a hard requirement for cmd.exe's own batch parser, not a style
# preference). Matches the upstream gradle/gradle repo's own convention.
gradlew text eol=lf

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
