# Copy this file to keystore.properties (which is gitignored) and replace every
# value locally. Never commit the real file or the referenced .jks/.keystore.
hydraUmcReleaseStoreFile=C:/secure-path/hydra-umc-android-control-release.jks
hydraUmcReleaseStorePassword=REPLACE_LOCALLY
hydraUmcReleaseKeyAlias=REPLACE_LOCALLY
hydraUmcReleaseKeyPassword=REPLACE_LOCALLY
