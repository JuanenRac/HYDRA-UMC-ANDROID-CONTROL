<?xml version="1.0" encoding="utf-8"?><!--
   Pre-Android-12 counterpart to data_extraction_rules.xml (same real
   AuthPrefs.kt AEADBadTagException crash this excludes from backup - see
   that file's comment for the full story). Ignored on API 31+, which reads
   data_extraction_rules.xml instead - both need the same exclusion since
   this app's minSdk is below 31.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="auth_prefs_encrypted.xml"/>
    <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_key_keyset__.xml"/>
    <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_value_keyset__.xml"/>
</full-backup-content>
