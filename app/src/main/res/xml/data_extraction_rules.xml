<?xml version="1.0" encoding="utf-8"?><!--
   Real bug this exists to prevent, not template boilerplate: with
   android:allowBackup="true" and no rules here, Android's cloud backup was
   including AuthPrefs.kt's EncryptedSharedPreferences file (the Tink keysets
   live inside that same file; the two keyset exclusions below only cover
   sibling files older library versions wrote) - live-reproduced
   crash: after a reinstall, Android restored that ciphertext but the
   Keystore-backed AES key it was encrypted with is hardware-tied and never
   survives a restore, so every decrypt attempt threw AEADBadTagException,
   crashing the app on every screen that touches auth (including login)
   until the corrupted file was cleared. AuthPrefs.kt now also recovers from
   this itself if it ever happens again, but excluding the file from backup
   in the first place is the real fix - there's nothing worth restoring in
   a per-device Keystore-encrypted secret anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml"/>
        <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_key_keyset__.xml"/>
        <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_value_keyset__.xml"/>
        <!-- The offline copy of the last known state (and the connection settings) stays on this device. -->
        <exclude domain="file" path="datastore"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml"/>
        <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_key_keyset__.xml"/>
        <exclude domain="sharedpref" path="auth_prefs_encrypted__androidx_security_crypto_encrypted_prefs_value_keyset__.xml"/>
        <exclude domain="file" path="datastore"/>
    </device-transfer>
</data-extraction-rules>
