    <!-- Bluetooth GATT and connection security -->
    <string name="tab_security">Security</string>
    <string name="tls_title">Connection security (TLS)</string>
    <string name="tls_mode_auto">Automatic</string>
    <string name="tls_mode_required">Require TLS</string>
    <string name="tls_mode_off">Plain only</string>
    <string name="tls_mode_auto_hint">Tries plain HTTP first and switches to HTTPS when the server only answers over TLS (default).</string>
    <string name="tls_mode_required_hint">Only HTTPS and WSS. A server without TLS is not used.</string>
    <string name="tls_mode_off_hint">Only plain HTTP and WS; HTTPS is never tried. Anyone on the network can read the traffic.</string>
    <string name="tls_pin_label">Server certificate fingerprint (SHA-256)</string>
    <string name="tls_pin_hint">64 hexadecimal characters, with or without colons. When set, only a server with exactly this certificate is accepted, even if it is self-signed.</string>
    <string name="tls_ca_label">Trusted CA certificate (PEM)</string>
    <string name="tls_ca_hint">Used instead of the system certificates when no fingerprint is set.</string>
    <string name="tls_save">Save security settings</string>
    <string name="tls_saved">Security settings saved. They apply to the next connection.</string>
    <string name="tls_error_fingerprint">The fingerprint must be 64 hexadecimal characters (SHA-256).</string>
    <string name="tls_error_ca">The text is not a valid PEM certificate.</string>
    <string name="tls_warning_plain_remote">Unencrypted connection to %1$s, which is not on your local network. Anyone on the path can read the session and its token. Use TLS or a VPN.</string>
    <string name="tls_plain_remote_title">Allow plain traffic outside the local network</string>
    <string name="tls_plain_remote_hint">Off by default. The app refuses unencrypted HTTP/WS to servers that are not on your local network, so the session token never crosses the Internet in the clear. Turn on only for a tunnel you trust.</string>
