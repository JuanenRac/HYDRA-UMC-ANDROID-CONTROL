    <string name="ble_error_gave_up">The Bluetooth link was lost and could not be restored.</string>
    <string name="ble_error_with_status">%1$s (code %2$d)</string>
    <string name="bt_show_all_devices">Show all Bluetooth devices</string>
    <string name="bt_show_all_hint">Off: only devices that advertise the HYDRA-UMC service are listed.</string>
    <string name="error_revision_changed">The robot changed since this app last read it (another operator or device) - the %1$s command was NOT applied. The robot was read again from the server: check it and repeat the command if it is still wanted.</string>
    <string name="access_conditional_label">Check that the robot has not changed</string>
    <string name="access_conditional_standard">Standard</string>
    <string name="access_conditional_strict">Strict</string>
    <string name="access_conditional_off">Off</string>
    <string name="access_conditional_hint">Each write carries the revision of the robot this app last saw; if someone else changed the robot in between, the server refuses it and the robot is read again. Standard checks reservations, the table and one-off commands; Strict checks everything but STOP; Off checks nothing. Jog and speed are not checked in Standard because they repeat many times a second. STOP is never checked.</string>
    <string name="audit_open">Audit record</string>
    <string name="audit_title">Audit record</string>
    <string name="audit_intro">What the server wrote down about the changes that matter: reservations, forced releases, arming of the jog, changes of the safety limits and global stops. Each line is chained to the one before it by a SHA-256, so a line changed or removed later shows when the chain is verified.</string>
