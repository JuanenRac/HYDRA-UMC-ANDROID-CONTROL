    <string name="tls_mode_auto">Automatique</string>
    <string name="tls_mode_required">Exiger TLS</string>
    <string name="tls_mode_off">Non chiffré uniquement</string>
    <string name="tls_mode_auto_hint">Essaie d\'abord HTTP non chiffré et passe à HTTPS quand le serveur ne répond qu\'en TLS (par défaut).</string>
