    <string name="tab_security">Sicherheit</string>
    <string name="tls_title">Verbindungssicherheit (TLS)</string>
    <string name="tls_mode_auto">Automatisch</string>
    <string name="tls_mode_required">TLS erzwingen</string>
    <string name="tls_mode_off">Nur unverschlüsselt</string>
    <string name="tls_mode_auto_hint">Versucht zuerst unverschlüsseltes HTTP und wechselt zu HTTPS, wenn der Server nur über TLS antwortet (Standard).</string>
    <string name="tls_mode_required_hint">Nur HTTPS und WSS. Ein Server ohne TLS wird nicht verwendet.</string>
    <string name="tls_mode_off_hint">Nur unverschlüsseltes HTTP und WS; HTTPS wird nie versucht. Jeder im Netzwerk kann den Datenverkehr mitlesen.</string>
    <string name="tls_pin_label">Fingerabdruck des Serverzertifikats (SHA-256)</string>
    <string name="tls_pin_hint">64 Hexadezimalzeichen, mit oder ohne Doppelpunkte. Wenn gesetzt, wird nur ein Server mit genau diesem Zertifikat akzeptiert, auch wenn es selbstsigniert ist.</string>
    <string name="tls_ca_label">Vertrauenswürdiges CA-Zertifikat (PEM)</string>
    <string name="tls_ca_hint">Wird anstelle der Systemzertifikate verwendet, wenn kein Fingerabdruck gesetzt ist.</string>
    <string name="tls_save">Sicherheitseinstellungen speichern</string>
    <string name="tls_saved">Sicherheitseinstellungen gespeichert. Sie gelten ab der nächsten Verbindung.</string>
    <string name="tls_error_fingerprint">Der Fingerabdruck muss aus 64 Hexadezimalzeichen bestehen (SHA-256).</string>
    <string name="tls_error_ca">Der Text ist kein gültiges PEM-Zertifikat.</string>
    <string name="tls_warning_plain_remote">Unverschlüsselte Verbindung zu %1$s, das nicht in deinem lokalen Netzwerk liegt. Jeder auf dem Weg kann die Sitzung und ihr Token lesen. Verwende TLS oder ein VPN.</string>
    <string name="tls_plain_remote_title">Unverschlüsselten Verkehr außerhalb des lokalen Netzes erlauben</string>
    <string name="tls_plain_remote_hint">Standardmäßig aus. Die App lehnt unverschlüsseltes HTTP/WS zu Servern außerhalb deines lokalen Netzes ab, damit das Sitzungstoken nie im Klartext durchs Internet geht. Nur für einen vertrauenswürdigen Tunnel einschalten.</string>
