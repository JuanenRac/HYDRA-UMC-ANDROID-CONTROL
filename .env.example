# Copy this file to .env (gitignored) and set your own value locally.
# Only needed to auto-publish a GitHub Release after prepare-github-release
# builds a signed APK - see publish-github-release.ps1/.sh. A personal
# access token with 'repo' scope, tied to your own GitHub account: this is
# what keeps publishing to "only me" - nobody without both your private
# release keystore AND this token can produce and publish a trusted update.
GITHUB_TOKEN=REPLACE_LOCALLY
